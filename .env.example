# LoveProof — local environment template.
#
# Copy to `.env` and adjust as needed:
#   cp .env.example .env
#
# Every value below is a PLACEHOLDER. The defaults are development-only and
# must be overridden in any shared environment. `.env` is git-ignored.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=loveproof
POSTGRES_USER=loveproof
POSTGRES_PASSWORD=loveproof
POSTGRES_PORT=5432

# --- Backend datasource ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/loveproof
SPRING_DATASOURCE_USERNAME=loveproof
SPRING_DATASOURCE_PASSWORD=loveproof

# --- Backend server ---
SERVER_PORT=8080

# --- Seeded administrator (Flyway V2, resynchronised by V3) ---
# The `admin_user` table and its seed migration already exist, and the account
# can sign in at /admin/login. The password hash below is the BCrypt hash of the
# documented development-only password "loveproof" — override it in any shared
# environment.
#
# The `V3` migration resynchronises the seeded row whenever the configured hash
# differs from the stored one, so changing this value and restarting is enough.
#
# A BCrypt hash contains '$' characters, which Flyway reads as the start of a
# placeholder. They are written as ${dollar} and expanded to a literal '$'.
LOVEPROOF_ADMIN_USERNAME=admin
LOVEPROOF_ADMIN_DISPLAY_NAME=LoveProof Admin
LOVEPROOF_ADMIN_ROLE=ADMIN
LOVEPROOF_ADMIN_PASSWORD_HASH=${dollar}2a${dollar}10${dollar}8I2C1tkDWUsoUCny.Ns4b.eE4sXgQ7lcJsXQ.WGh2AMFMMAEFS99O

# --- Consent and hashing ---
# Identifier of the consent wording shown to the visitor at submission time.
LOVEPROOF_CONSENT_TEXT_VERSION=v1
# Salt used when hashing client IP addresses. Change it per environment.
LOVEPROOF_IP_HASH_SALT=loveproof-local-salt

# --- Cookies ---
# Marks the session and CSRF cookies `Secure`, so the browser only sends them
# over HTTPS. Leave this false for local HTTP; the `prod` profile sets it to
# true regardless, and a production deployment must sit behind a
# TLS-terminating proxy.
LOVEPROOF_SECURE_COOKIES=false
